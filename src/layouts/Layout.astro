---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StackingPanes from '../components/StackingPanes';
import ReadingMemory from '../components/world/ReadingMemory.astro';

interface Props {
	title?: string;
	description?: string;
}

const { title = 'Map the Wild', description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/favicon.svg`} />
		{description && <meta name="description" content={description} />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body class="split-layout">
		<div id="main-content" class="main-content">
			<Header />
			<slot />
			<Footer />
		</div>
		<StackingPanes client:load />
		<ReadingMemory />
	</body>
</html>
