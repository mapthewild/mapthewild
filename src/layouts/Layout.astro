---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StackingPanes from '../components/StackingPanes';
import ReadingMemory from '../components/world/ReadingMemory.astro';

interface Props {
	title?: string;
	description?: string;
	reading?: boolean;
	home?: boolean;
}

const { title = 'Map the Wild', description, reading = false, home = false } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
		{description && <meta name="description" content={description} />}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="stylesheet" href="/mapthewild/journal/journal.css" />
	</head>
	<body class:list={['split-layout', 'journal-site', reading && 'journal-reading', home && 'journal-home']}>
		<div id="main-content" class="main-content">
			<Header home={home} />
			{reading ? <div class="journal-reading-layout"><aside class="journal-companion" aria-label="Your place in the article"><div id="journal-side-slot"></div><div id="journal-guide"></div></aside><div id="journal-content" class="journal-reading-content" tabindex="-1"><slot /></div></div> : <div id="journal-content" tabindex="-1"><slot /></div>}
			{reading && <div id="journal-departure-slot"></div>}
			<Footer />
		</div>
		<StackingPanes client:load />
		<ReadingMemory showMode={false} />
		<script is:inline type="module" src="/mapthewild/journal/journal.js"></script>
	</body>
</html>
