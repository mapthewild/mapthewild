---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { territories as islandMeta, canonicalTerritory, inTerritory } from '../../lib/territories'
import { standaloneEssays } from '../../lib/standaloneEssays'
import { futureDadsEpisodes, FUTURE_DADS_SITE } from '../../lib/futureDadsEpisodes'
import { getRoutePosts, getTerritoryRouteMode } from '../../lib/voyageGraph'

export async function getStaticPaths() {
  const posts = await getCollection('posts')
  const publishedPosts = posts.filter(post => !post.data.draft)

  // Get all unique islands
  const islands = new Set<string>()
  publishedPosts.forEach(post => {
    post.data.islands?.forEach(island => islands.add(canonicalTerritory(island)))
  })

  standaloneEssays.forEach(essay => essay.data.islands.forEach(island => islands.add(canonicalTerritory(island))))

  // Future Dads Club's episodes live on their own site but get a territory page here.
  islands.add('futuredads')

  return Array.from(islands).map(island => ({
    params: { island },
    props: { island }
  }))
}

const { island } = Astro.props
const meta = islandMeta[island] || { name: island, description: '' }

const posts = await getCollection('posts')
const collectionPosts = posts
  .filter(post => !post.data.draft && inTerritory(post.data.islands, island))
  .map(post => ({
    slug: post.slug,
    href: `/mapthewild/posts/${post.slug}`,
    data: post.data,
  }))

const standaloneForIsland = [...standaloneEssays, ...futureDadsEpisodes]
  .filter(essay => inTerritory(essay.data.islands, island))

// A series reads in order (part 1 first); dated territories list newest first.
const isSeries = getTerritoryRouteMode(island) === 'series'
const inReadingOrder = getRoutePosts([...collectionPosts, ...standaloneForIsland])
const islandPosts = isSeries ? inReadingOrder : [...inReadingOrder].reverse()

function formatDate(date: Date) {
  return date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
    timeZone: 'UTC'
  })
}
---

<Layout title={`${meta.name} - Map the Wild`}>
  <main class="relative z-10 max-w-2xl mx-auto px-6 py-16 md:py-24">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/mapthewild/' },
        { label: 'Places', href: '/mapthewild/islands' },
        { label: meta.name }
      ]}
    />

    <header class="mb-12">
      <h1 class="text-3xl md:text-4xl font-display text-ink mb-4">
        {meta.name}
      </h1>
      <p class="journal-collection-count">{islandPosts.length} {island === 'futuredads' ? 'episodes' : islandPosts.length === 1 ? 'post' : 'posts'}</p>
      {meta.description && (
        <p class="text-xl text-ink-muted">{meta.description}</p>
      )}
      {island === 'futuredads' && (
        <p class="mt-4"><a class="podcast-link" href={FUTURE_DADS_SITE}>Listen on futuredadsclub.com ↗</a></p>
      )}
    </header>

    <div class="space-y-4">
      {islandPosts.map((post, index) => {
        const colors = ['ochre', 'verdigris', 'sienna', 'rose'];
        const colorClass = colors[index % colors.length];
        return (
        <a
          href={post.href || `/mapthewild/posts/${post.slug}`}
          class={`post-item post-item-${colorClass}`}
        >
          <time class="post-item-date">
            {isSeries && `Part ${index + 1} of ${islandPosts.length} · `}{formatDate(post.data.date)}
          </time>
          <h2 class="post-item-title">
            {post.data.title}{post.href?.startsWith('https://') && <span aria-hidden="true"> ↗</span>}
          </h2>
          <p class="post-item-excerpt">
            {post.data.description}
          </p>
        </a>
        );
      })}
    </div>

    {islandPosts.length === 0 && (
      <p class="text-ink-muted">No posts in this territory yet.</p>
    )}
  </main>
</Layout>

<style>
  .podcast-link { display: inline-flex; align-items: center; min-height: 32px; }
  /* Hover items with colored left border - from design system */
  .post-item {
    display: block;
    padding: var(--space-lg);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-ochre);
    box-shadow: var(--shadow-card);
    transition: all 0.2s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .post-item:hover {
    transform: translateX(4px);
    box-shadow: var(--shadow-hover);
  }

  /* Color variants */
  .post-item-ochre { border-left-color: var(--color-ochre); }
  .post-item-ochre:hover { background: rgba(196, 160, 53, 0.05); }
  .post-item-ochre .post-item-title { color: var(--color-ochre); }
  .post-item-ochre:hover .post-item-title { color: var(--color-ochre-dark); }

  .post-item-verdigris { border-left-color: var(--color-verdigris); }
  .post-item-verdigris:hover { background: rgba(45, 106, 106, 0.05); }
  .post-item-verdigris .post-item-title { color: var(--color-verdigris); }

  .post-item-sienna { border-left-color: var(--color-sienna); }
  .post-item-sienna:hover { background: rgba(160, 62, 32, 0.05); }
  .post-item-sienna .post-item-title { color: var(--color-sienna); }

  .post-item-rose { border-left-color: var(--color-rose); }
  .post-item-rose:hover { background: rgba(201, 160, 160, 0.08); }
  .post-item-rose .post-item-title { color: var(--color-rose-dark); }

  .post-item-date {
    font-size: 13px;
    color: var(--color-ink-muted);
    display: block;
    margin-bottom: var(--space-sm);
  }

  .post-item-title {
    font-size: 18px;
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'WONK' 1, 'SOFT' 50;
    margin-bottom: var(--space-sm);
    transition: color 0.2s;
  }

  .post-item-excerpt {
    font-size: 15px;
    color: var(--color-ink-light);
    line-height: 1.6;
  }
</style>
