---
import { getCollection } from 'astro:content'
import Layout from '../../layouts/Layout.astro'
import Breadcrumbs from '../../components/Breadcrumbs.astro'
import { territories as islandMeta, canonicalTerritory } from '../../lib/territories'
import { standaloneEssays } from '../../lib/standaloneEssays'
import { journalArt } from '../../lib/journalNavigation'
import { territoryNodes } from '../../lib/voyageGraph'
import { futureDadsEpisodes } from '../../lib/futureDadsEpisodes'

const posts = await getCollection('posts')
const publishedPosts = posts.filter(post => !post.data.draft)

// Count posts per island
const islandCounts: Record<string, number> = {}
publishedPosts.forEach(post => {
  new Set(post.data.islands?.map(canonicalTerritory)).forEach(island => {
    islandCounts[island] = (islandCounts[island] || 0) + 1
  })
})

// Standalone essays count too, so these numbers match each territory page.
// Standalone-only territories also have their own generated page.
standaloneEssays.forEach(essay => {
  new Set(essay.data.islands.map(canonicalTerritory)).forEach(island => {
    islandCounts[island] = (islandCounts[island] || 0) + 1
  })
})

// Future Dads Club's episodes live on their own site; its territory page lists them.
islandCounts['futuredads'] = futureDadsEpisodes.length

// Get islands that have posts, ordered by count
const postBasedIslands = Object.entries(islandCounts)
  .sort((a, b) => b[1] - a[1])
  .map(([id, count]) => ({
    id,
    count,
    ...islandMeta[id] || { name: id, description: '', href: `/mapthewild/islands/${id}` }
  }))

// Add dedicated territory pages (like Sunday Ritual) that aren't post collections
const dedicatedIslands = Object.entries(islandMeta)
  .filter(([id, meta]) => meta.dedicatedPage && !islandCounts[id])
  .map(([id, meta]) => ({
    id,
    count: null,
    ...meta
  }))

// Match the strip, so the places do not change order between views.
const activeIslands = [...postBasedIslands, ...dedicatedIslands].sort((a,b) =>
  territoryNodes.findIndex(place => place.id === a.id) - territoryNodes.findIndex(place => place.id === b.id))
---

<Layout title="Places - Map the Wild">
  <main class="journal-directory relative z-10 max-w-2xl mx-auto px-6 py-16 md:py-24">
    <Breadcrumbs
      items={[
        { label: 'Home', href: '/mapthewild/' },
        { label: 'Places' }
      ]}
    />

    <h1 class="text-3xl md:text-4xl font-display text-ink mb-12">
      Places
    </h1>

    <div class="journal-place-grid">
      {activeIslands.map((island) => (
        <a
          href={island.href || `/mapthewild/islands/${island.id}`}
          class="journal-place-card"
        >
          <span class="journal-place-picture" style={`background-image:url('${(journalArt[island.id] ?? journalArt.home).src}');background-position:${(journalArt[island.id] ?? journalArt.home).position};background-size:${(journalArt[island.id] ?? journalArt.home).size}`} aria-hidden="true"></span>
          <h2>
            {island.name}{island.href?.startsWith('https://') && <span aria-hidden="true"> ↗</span>}
            {island.count !== null && (
              <span class="territory-item-count">({island.count})</span>
            )}
          </h2>
          <p class="territory-item-description">{island.description}</p>
        </a>
      ))}
    </div>
  </main>
</Layout>

<style>
  /* Territory items with verdigris border (navigation accent) */
  .territory-item {
    display: block;
    padding: var(--space-lg);
    background: var(--color-white);
    border-radius: var(--radius-lg);
    border-left: 3px solid var(--color-verdigris);
    box-shadow: var(--shadow-card);
    transition: all 0.2s ease;
    text-decoration: none;
    cursor: pointer;
  }

  .territory-item:hover {
    transform: translateX(4px);
    background: rgba(45, 106, 106, 0.05);
    box-shadow: var(--shadow-hover);
  }

  .territory-item-title {
    font-size: 22px;
    font-family: 'Fraunces', Georgia, serif;
    font-variation-settings: 'WONK' 1, 'SOFT' 50;
    color: var(--color-ink);
    margin-bottom: var(--space-sm);
    transition: color 0.2s;
  }

  .territory-item:hover .territory-item-title {
    color: var(--color-verdigris);
  }

  .territory-item-count {
    font-size: 16px;
    font-weight: normal;
    color: var(--color-ink-muted);
    margin-left: var(--space-sm);
  }

  .territory-item-description {
    font-size: 15px;
    color: var(--color-ink-light);
    line-height: 1.6;
  }
</style>
