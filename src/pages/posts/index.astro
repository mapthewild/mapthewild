---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostVisualCard from '../../components/PostVisualCard.astro';
import { standaloneEssays } from '../../lib/standaloneEssays';

const posts = await getCollection('posts');
const publishedPosts = posts.filter(post => !post.data.draft);

const allPosts = [
  ...publishedPosts.map(post => ({
    slug: post.slug,
    href: `/mapthewild/posts/${post.slug}`,
    data: post.data,
  })),
  ...standaloneEssays,
];

const sortedPosts = allPosts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Posts - Map the Wild">
  <main class="relative z-10 max-w-5xl mx-auto px-6 py-16 md:py-24">
    <h1 class="text-3xl md:text-4xl font-display text-ink mb-12">
      All Posts <span class="text-ink-muted">({sortedPosts.length})</span>
    </h1>

    <div class="post-card-stack">
      {sortedPosts.map((post, index) => (
        <PostVisualCard
          post={post}
          href={post.href}
          featured={index === 0}
          imageSide={index % 2 === 0 ? 'left' : 'right'}
        />
      ))}
    </div>
  </main>
</Layout>

<style>
  .post-card-stack {
    display: grid;
    gap: var(--space-lg);
  }
</style>
