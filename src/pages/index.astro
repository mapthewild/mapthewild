---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { journalArt } from '../lib/journalNavigation';
import { territories } from '../lib/territories';
const published = (await getCollection('posts')).filter(p=>!p.data.draft);
const posts = ['starting-your-nowbrary','claude-wrapped'].flatMap(slug=>{
  const post=published.find(p=>p.slug===slug);
  return post?[{href:`/mapthewild/posts/${post.slug}`,data:post.data}]:[];
});
---
<Layout title="Map the Wild" home>
  <link rel="stylesheet" href="/mapthewild/journal/entrance.css" />
  <main class="blog-opening" id="blog">
    <section class="journal-intro"><p class="eyebrow">Writing, projects and places</p><h1 tabindex="-1" id="blog-title">Map the Wild</h1><p class="original-intro">Brain flickers, farts and finer arts from my towers of sand.</p></section>
    <section class="journal-writing" aria-labelledby="writing-title"><div class="writing-heading"><h2 id="writing-title">Writing</h2></div><div class="journal-grid">
      {posts.map(post=>{const key=post.data.islands?.[0]??'map';const art=journalArt[key]??journalArt.home;return <article class="journal-card"><a class="journal-picture" href={post.href} aria-label={`Read ${post.data.title}`} style={`background-image:url('${art.src}');background-position:${art.position};background-size:${art.size}`}></a><p class="eyebrow">{territories[key]?.name??'Writing'}</p><h2><a href={post.href}>{post.data.title}</a></h2><p>{post.data.description}</p><a class="read-post" href={post.href} aria-label={`Read ${post.data.title}`}>Read post <span aria-hidden="true">→</span></a></article>;})}
    </div></section>
    <nav class="entry-footer" aria-label="More from Map the Wild"><a href="/mapthewild/posts/">All writing →</a><a href="/mapthewild/islands/">Places →</a><a href="/mapthewild/about/">About</a></nav>
    <div class="entry-cue"><span>Explore below <span aria-hidden="true">↓</span></span><label><input id="reduce-motion" type="checkbox"> Reduce motion</label></div>
  </main>
  <section class="reveal-story" id="explore-entry" aria-label="Explore the sea and islands">
    <div class="reveal-stage" data-phase="glimpse">
      <figure class="illustrated-view"><img src="/mapthewild/journal/world-overview.png" alt="A reading house, workshop, homes, quiet court, storytelling canopy and game pavilion beside the water." width="1536" height="1024"><figcaption><span>Explore</span><span>Scroll to the sea <span aria-hidden="true">↓</span></span></figcaption></figure>
      <div class="world-reveal" id="sea-view" inert aria-hidden="true"><div class="sea-camera"><iframe id="sea-frame" title="Explore: sail between the islands" src="/mapthewild/explore/?embedded=blog" tabindex="-1"></iframe></div><div class="explore-return"><button id="return-writing">↑ Back to writing</button><a id="return-article" href="/mapthewild/posts/" hidden>Return to your article</a></div></div>
      <div class="spyglass" aria-hidden="true"><div class="scope-barrel"><i></i><i></i><i></i><b></b></div><div class="scope-rim"><span class="lens-light"></span></div></div>
      <nav class="reveal-tools" aria-label="Enter Explore"><button id="back-writing">↑ Writing</button><button data-show-map class="skip-reveal">Skip to Explore</button></nav>
      <p class="sr-only" id="entry-status" role="status">Opening Explore…</p>
    </div>
  </section>
  <script is:inline type="module" src="/mapthewild/journal/entrance.js"></script>
</Layout>
