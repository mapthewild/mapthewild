---
import App from '../components/sunday-ritual/App'
import ReadingMemory from '../components/world/ReadingMemory.astro'
import '../styles/global.css'
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sunday Ritual - The Sunday Morning Ritual</title>
    <meta name="description" content="A 30-minute couples ritual to reconnect and build your relationship manual together." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      .sr-world-link { position: absolute; top: 12px; right: 16px; z-index: 50; font: 13px Georgia, serif; color: #526551; text-decoration: none; }
      /* Override mapthewild's base styles for Sunday Ritual */
      body {
        background-color: #FAF7F2 !important;
        background-image: none !important;
        font-family: 'Inter', sans-serif;
        margin: 0;
        padding: 0;
      }

      /* The app has no site header, so give readers a way back. */
      .sr-site-link {
        position: absolute;
        top: 12px;
        left: 16px;
        z-index: 50;
        color: #6b5d4d;
        font-family: 'Libre Baskerville', Georgia, serif;
        font-size: 13px;
        text-decoration: none;
      }

      .sr-site-link:hover,
      .sr-site-link:focus-visible {
        text-decoration: underline;
      }
    </style>
  </head>
  <body class="min-h-screen bg-[#FAF7F2]">
    <a class="sr-site-link" href="/mapthewild/islands/sundayritual">&larr; Map the Wild</a>
    <a class="sr-world-link" href="/mapthewild/explore?port=together" data-world-mode>Explore ↗</a>
    <App client:only="react" />
    <ReadingMemory showMode={false} />
  </body>
</html>
