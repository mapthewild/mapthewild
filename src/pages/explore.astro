---
import HarbourWorld from '../components/world/HarbourWorld';
import ShoreEssayLink from '../components/world/ShoreEssayLink.astro';
import {getEntry} from 'astro:content';
import {SHORE_ESSAY_SLUGS} from '../lib/world/shore-reading';
const posts=await Promise.all(SHORE_ESSAY_SLUGS.map(slug=>getEntry('posts',slug)));
if(posts.some(post=>!post||post.data.draft))throw new Error('The Nowbrary shore essays must be published.');
const [first,second]=posts;
const {Content:NowbraryPost}=await first!.render();
const {Content:StartingPost}=await second!.render();
const essays=posts.map((post,i)=>({slug:SHORE_ESSAY_SLUGS[i],title:post!.data.title,description:post!.data.description,minutes:Math.max(1,Math.ceil(post!.body.split(/\s+/).length/220))}));
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="An inhabited sea of books, questions and things to do together. Explore the first shores of Map the Wild." />
    <meta name="theme-color" content="#285d5c" />
    <title>The first shores — Map the Wild</title>
    <link rel="icon" type="image/svg+xml" href="/mapthewild/favicon.svg" />
  </head>
  <body><HarbourWorld client:load essays={essays}>
    <div slot="nowbraryPost"><NowbraryPost components={{a:ShoreEssayLink}}/></div>
    <div slot="startingPost"><StartingPost components={{a:ShoreEssayLink}}/></div>
  </HarbourWorld></body>
</html>
