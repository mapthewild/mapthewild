---
interface Props { showMode?: boolean; topLevel?: boolean }
const { showMode = true, topLevel = false } = Astro.props;
---
<link rel="stylesheet" href="/mapthewild/reading-mode.css" />
{showMode && <nav class="reading-world-mode" aria-label="View mode"><span aria-current="page">Read</span><a href="/mapthewild/explore" target={topLevel ? '_top' : undefined} data-world-mode>Explore</a></nav>}
<script is:inline src="/mapthewild/reading-memory.js" defer></script>
