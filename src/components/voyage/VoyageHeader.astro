---
import { getCollection } from 'astro:content';
import VoyageShip from './VoyageShip';
import VoyageRuntime from './VoyageRuntime';
import { standaloneEssays } from '../../lib/standaloneEssays';
import { futureDadsEpisodes } from '../../lib/futureDadsEpisodes';
import {
  getVoyageState,
  iconNameForVoyageKind,
  VOYAGE_HEIGHT,
  VOYAGE_WIDTH,
} from '../../lib/voyageGraph';

const posts = [...(await getCollection('posts')), ...standaloneEssays, ...futureDadsEpisodes];
const currentPath = Astro.url.pathname;
const voyage = getVoyageState(currentPath, posts);
const { nodes, routes, currentNode } = voyage;
const isPostPage = /^\/mapthewild\/posts\/[^/]+\/?$/.test(currentPath);
const aboutIsActive = currentPath === '/mapthewild/about' || currentPath === '/mapthewild/about/';
---

<header class:list={['voyage-header', isPostPage && 'voyage-header--compact']}>
  <div class="voyage-header__shell">
    <div class="voyage-header__meta">
      <a class="voyage-header__brand" href="/mapthewild/">Map the Wild</a>
      <a class={`voyage-header__utility ${aboutIsActive ? 'is-active' : ''}`} href="/mapthewild/about">
        About
      </a>
    </div>

    <nav class="voyage-header__scroller" aria-label="Primary voyage navigation">
      <div class="voyage-header__inner">
        <svg
          class="voyage-map-base"
          viewBox={`0 0 ${VOYAGE_WIDTH} ${VOYAGE_HEIGHT}`}
          preserveAspectRatio="none"
          aria-hidden="true"
          focusable="false"
        >
          <rect class="voyage-map-base__paper" x="8" y="10" width="1184" height="198" rx="18" />
          <path class="voyage-map-base__coast voyage-map-base__coast--top" d="M 44 54 C 132 24 210 68 292 42 C 384 12 470 56 556 34 C 692 0 828 42 936 22 C 1038 4 1116 36 1162 28" />
          <path class="voyage-map-base__coast voyage-map-base__coast--bottom" d="M 48 182 C 158 152 244 192 348 166 C 458 138 548 184 664 162 C 790 138 872 180 986 154 C 1076 134 1130 166 1162 152" />
          {routes.map((route) => (
            <path
              class={`voyage-route ${route.active ? 'is-active' : ''}`}
              d={route.d}
              data-route-id={route.id}
            />
          ))}
          {nodes.map((node) => (
            <g
              class={`voyage-register voyage-register--${node.kind} voyage-register--${node.status || 'future'}`}
              data-node-id={node.id}
              transform={`translate(${node.x} ${node.y})`}
            >
              <circle class="voyage-register__outer" r="14" />
              <circle class="voyage-register__inner" r="2.25" />
              <path class="voyage-register__axis voyage-register__axis--x" d="M -22 0 H -7 M 7 0 H 22" />
              <path class="voyage-register__axis voyage-register__axis--y" d="M 0 -22 V -7 M 0 7 V 22" />
            </g>
          ))}
        </svg>

        <VoyageShip currentNode={currentNode} client:load />
        <VoyageRuntime currentNode={currentNode} client:load />

        {nodes.map((node) => {
          const isCurrent = node.id === currentNode.id && !aboutIsActive;
          const iconName = iconNameForVoyageKind(node.kind);
          return (
            <a
              class={`voyage-port voyage-port--${node.kind} voyage-port--${node.status || 'future'} ${isCurrent ? 'is-current' : ''}`}
              href={node.href}
              aria-label={`${node.label}${node.meta ? `, ${node.meta}` : ''}`}
              aria-current={isCurrent ? 'page' : undefined}
              data-kind={node.kind}
              data-icon={iconName}
              data-status={node.status || 'future'}
              data-node-id={node.id}
              data-x={node.x}
              data-y={node.y}
              data-dock-x={node.x}
              data-dock-y={node.y}
              data-terminal={node.isTerminal ? 'true' : undefined}
              style={`--x: ${node.x}; --y: ${node.y};`}
            >
              <span class="voyage-port__token" aria-hidden="true">
                <span class="voyage-port__mark"></span>
              </span>
              <span class="voyage-port__label" title={node.label}>
                <span class="voyage-port__title">{node.label}</span>
                {node.meta && <span class="voyage-port__meta">{node.meta}</span>}
              </span>
            </a>
          );
        })}
      </div>
    </nav>
  </div>
</header>
