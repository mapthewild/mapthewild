---
import { getPostVisual } from '../lib/postVisuals';

type PostLike = {
  slug?: string;
  id?: string;
  data: {
    title: string;
    description?: string;
    excerpt?: string;
    date?: string | Date;
    territory?: string;
    island?: string;
    islands?: string[];
    category?: string;
    cardImage?: string;
    heroImage?: string;
    motifs?: string[];
    accent?: string;
  };
};

type Props = {
  post: PostLike;
  href?: string;
  featured?: boolean;
  imageSide?: 'left' | 'right';
};

const { post, href, featured = false, imageSide = 'left' } = Astro.props;
const visual = getPostVisual(post.data);

const title = post.data.title;
const description = post.data.description ?? post.data.excerpt ?? '';
const postHref = href ?? `/mapthewild/posts/${post.slug ?? post.id ?? ''}/`;
const date = post.data.date ? new Date(post.data.date) : null;
const dateLabel = date
  ? date.toLocaleDateString('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    })
  : '';
---

<article
  class:list={[
    'mtw-post-card',
    `mtw-post-card--${visual.accent}`,
    featured && 'mtw-post-card--featured',
    imageSide === 'right' && 'mtw-post-card--image-right',
  ]}
>
  <div class="mtw-post-card__image-link">
    <img
      class="mtw-post-card__image"
      src={visual.image}
      alt=""
      loading={featured ? 'eager' : 'lazy'}
      decoding="async"
    />
  </div>

  <div class="mtw-post-card__body">
    {dateLabel && <time class="mtw-post-card__date">{dateLabel}</time>}

    <h2 class="mtw-post-card__title">
      <a href={postHref}>{title} <span aria-hidden="true">&rarr;</span></a>
    </h2>

    <span class="mtw-post-card__ornament" aria-hidden="true"></span>

    {description && <p class="mtw-post-card__excerpt">{description}</p>}

    <span class="mtw-post-card__read-more" aria-hidden="true">
      Read post &rarr;
    </span>
  </div>
</article>
